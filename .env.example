# Local development needs no environment variables; it uses private-data/followthrough.sqlite.
# Optional local override; an absolute path is required.
# DATABASE_PATH=/absolute/path/to/followthrough.sqlite

# Hosted database: set both. Never use NEXT_PUBLIC_ for any of these values.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-database-token

# Vercel build-time check of All Deployments protection.
# VERCEL_PROJECT_ID=prj_your_project_id
# VERCEL_API_TOKEN=your_vercel_api_token
# VERCEL_TEAM_ID=team_your_team_id
