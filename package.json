{
  "name": "followthrough",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --conditions=react-server --import tsx --test scripts/*.test.ts",
    "check:deployment": "node --env-file-if-exists=.env.local --import tsx scripts/check-deployment.ts",
    "migrate:cloud": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-cloud.ts",
    "seed:demo": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo.ts",
    "seed:x": "node --env-file-if-exists=.env.local --import tsx scripts/seed-x.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
